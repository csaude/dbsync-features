<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog context="central"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

	<changeSet author="dchirinda" id="20231213-1100">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="updated_site"/>
			</not>
		</preConditions>
		<comment>Adding updated_site table</comment>

		<createTable tableName="updated_site">
			<column autoIncrement="true" name="id" type="BIGINT">
				<constraints nullable="false" primaryKey="true"/>
			</column>
			<column name="site_id" type="VARCHAR(100)">
				<constraints nullable="false"/>
			</column>
			<column name="version" type="VARCHAR(255)">
				<constraints unique="true" nullable="false"/>
			</column>
			<column name="created_at" type="DATETIME(3)">
				<constraints nullable="false"/>
			</column>
			<column name="updated_at" type="DATETIME(3)">
				<constraints nullable="true"/>
			</column>
			<column name="is_active" type="BOOLEAN">
				<constraints nullable="false"/>
			</column>
		</createTable>
	</changeSet>

	<changeSet author="dchirinda" id="20240320-1100">
		<comment>Removing unique constraint from version column</comment>
		<dropUniqueConstraint columnNames="version" constraintName="version" tableName="updated_site"/>
	</changeSet>

	<changeSet author="dchirinda" id="2020228-1101">
		<comment>Removing unique constraint from current_version column</comment>
		<dropUniqueConstraint columnNames="current_version" constraintName="current_version" tableName="application_update_log"/>
	</changeSet>

	<changeSet author="dchirinda" id="20250228-1103">
		<addColumn tableName="updated_site">
			<column name="script_name" type="VARCHAR(100)"/>
		</addColumn>
		<addColumn tableName="updated_site">
			<column name="executed" type="BOOLEAN">
				<constraints nullable="false" />
			</column>
		</addColumn>
		<addColumn tableName="updated_site">
			<column name="log" type="TEXT">
				<constraints nullable="false" />
			</column>
		</addColumn>
		<addColumn tableName="updated_site">
			<column name="received_date" type="DATETIME(3)">
				<constraints nullable="false" />
			</column>
		</addColumn>
	</changeSet>
</databaseChangeLog>