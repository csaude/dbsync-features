<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog context="central"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

	<changeSet author="dchirinda" id="20230905-1100">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="email_notification_log"/>
			</not>
		</preConditions>
		<comment>Adding email_notification_log table</comment>

		<createTable tableName="email_notification_log">
			<column autoIncrement="true" name="id" type="BIGINT">
				<constraints nullable="false" primaryKey="true"/>
			</column>
			<column name="site_id" type="VARCHAR(100)">
				<constraints nullable="false"/>
			</column>
			<column name="message_type" type="VARCHAR(255)">
				<constraints nullable="false"/>
			</column>
			<column name="subject" type="VARCHAR(255)">
				<constraints nullable="false"/>
			</column>
			<column name="date_sent" type="DATETIME(3)">
				<constraints nullable="false"/>
			</column>
			<column name="message_uuid" type="VARCHAR(255)">
				<constraints unique="true"/>
			</column>
		</createTable>
	</changeSet>
	<changeSet author="dchirinda" id="20250305-1100">
		<addColumn tableName="email_notification_log">
			<column name="mail_recipients"  type="VARCHAR(255)">
			</column>
		</addColumn>
		<addColumn tableName="email_notification_log">
			<column name="mail_content"  type="TEXT">
			</column>
		</addColumn>
		<addColumn tableName="email_notification_log">
			<column name="attachement_name"  type="VARCHAR(255)">
			</column>
		</addColumn>
		<addColumn tableName="email_notification_log">
			<column name="mail_attachment"  type="TEXT">
			</column>
		</addColumn>
		<addColumn tableName="email_notification_log">
			<column name="mail_site_origin"  type="VARCHAR(255)">
			</column>
		</addColumn>
		<addColumn tableName="email_notification_log">
			<column name="email_sent" type="BOOLEAN">
				<constraints nullable="false" />
			</column>
		</addColumn>
	</changeSet>
	<changeSet author="dchirinda" id="20250305-1102">
		<update tableName="email_notification_log">
			<column name="email_sent" valueBoolean="true"/>
		</update>
	</changeSet>
	<changeSet id="20250305-1103" author="dchirinda">
		<modifyDataType
				tableName="email_notification_log"
				columnName="mail_attachment"
				newDataType="LONGTEXT"/>
	</changeSet>
	<changeSet id="20250305-1104" author="dchirinda">
		<modifyDataType
				tableName="email_notification_log"
				columnName="mail_recipients"
				newDataType="LONGTEXT"/>
	</changeSet>
</databaseChangeLog>
